# Atlas environment variables.
#
# Local development (defaults work without setting anything):
#   NEXT_PUBLIC_API_URL defaults to http://localhost:8000
#   NEXT_PUBLIC_AUTH_ENABLED defaults to auth-on (no preview mode)
#
# Production / preview deployment on Cloudflare Pages: set all three.

# Backend API base URL. The existing export lives in atlas/api.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Preview-mode toggle. Set to "false" on the public preview deployment
# to disable the Save/localStorage persistence path and surface the
# preview banner + disabled-save tooltip. Any other value (or unset)
# keeps auth and saves working for local development.
NEXT_PUBLIC_AUTH_ENABLED=true

# Flag-action destination (Formspree form endpoint). Prospect feedback
# from the preview is POSTed here as structured JSON. Leave blank in
# local dev — reportFlag() is a no-op when unset.
NEXT_PUBLIC_FLAG_ENDPOINT=
