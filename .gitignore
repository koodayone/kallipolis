# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pipeline cache (PDFs, extracted JSON, logs)
backend/pipeline/cache/
backend/pipeline/logs/

# employer pipeline runtime artifacts (state files, progress logs, audit reports)
backend/employers/.enrich_progress.log
backend/employers/.enrich_state.json
backend/employers/.fn_diff_report.json
backend/employers/dropped.jsonl
backend/employers/.populate_progress.log
backend/employers/.populate_state.json
backend/employers/.classify_progress.log
backend/employers/.classify_state.json
backend/employers/.audit_report.json
